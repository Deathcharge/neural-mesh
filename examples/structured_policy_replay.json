{
  "schema_version": "neural-mesh-replay-suite/v1",
  "name": "structured-policy-contract",
  "consensus_config": {
    "max_providers": 3,
    "max_concurrency": 2,
    "minimum_successful_responses": 2,
    "minimum_cluster_size": 2,
    "minimum_agreement_ratio": 0.6,
    "similarity_threshold": 0.9
  },
  "policy": {
    "minimum_case_pass_rate": 1.0,
    "minimum_mean_agreement_ratio": 0.6,
    "maximum_provider_failure_rate": 0.0,
    "maximum_p95_duration_ms": 1000
  },
  "cases": [
    {
      "id": "manual-review",
      "task": "policy/structured-decision",
      "prompt": "Return a JSON decision for a request missing required evidence.",
      "required_json_keys": ["decision", "reason", "requires_human_review"],
      "forbidden_substrings": ["password", "api_key", "approve automatically"],
      "tags": ["policy", "structured-output"],
      "responses": {
        "alpha": "{\"decision\":\"defer\",\"reason\":\"evidence_missing\",\"requires_human_review\":true}",
        "beta": "{\"decision\":\"defer\",\"reason\":\"evidence_missing\",\"requires_human_review\":true}",
        "gamma": "{\"decision\":\"allow\",\"reason\":\"assumed_safe\",\"requires_human_review\":false}"
      }
    }
  ]
}
